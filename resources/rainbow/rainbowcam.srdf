<?xml version="1.0" encoding="utf-8"?>
<robot name="rainbowcam">
  <!-- Rainbow VAMP self-collision pairs (spheres_rainbow_1004/make_srdf.py), 38 links, 703 pairs: 478 checked; disabled: Contact 2, Derived 72, Fixed 6, Never 145. Derived = qaa derived('rainbow').self_collision_exclusions; Fixed = rigid in VAMP's model (head pan/tilt baked); Never = the exact hulls never touch within the master limits (random census + distance minimisation); Contact = hulls a few mm apart at the stow posture. -->
  <disable_collisions link1="base" link2="wheel_r" reason="Adjacent"/>
  <disable_collisions link1="base" link2="wheel_l" reason="Adjacent"/>
