<?xml version="1.0"?>
<robot name="spot">
  <group name="arm">
    <joint name="arm_sh0"/>
    <joint name="arm_sh1"/>
    <joint name="arm_el0"/>
    <joint name="arm_el1"/>
    <joint name="arm_wr0"/>
    <joint name="arm_wr1"/>
  </group>
  <disable_collisions link1="body" link2="payload" reason="Adjacent"/>
  <disable_collisions link1="body" link2="arm_link_sh0" reason="Adjacent"/>
  <disable_collisions link1="body" link2="arm_link_sh1" reason="Adjacent"/>
  <disable_collisions link1="body" link2="arm_link_hr0" reason="Adjacent"/>
  <disable_collisions link1="payload" link2="arm_link_sh0" reason="Never"/>
  <disable_collisions link1="payload" link2="arm_link_sh1" reason="Never"/>
  <disable_collisions link1="arm_link_sh0" link2="arm_link_sh1" reason="Adjacent"/>
  <disable_collisions link1="arm_link_sh0" link2="arm_link_el0" reason="Never"/>
  <disable_collisions link1="arm_link_sh0" link2="arm_link_hr0" reason="Adjacent"/>
  <disable_collisions link1="arm_link_sh1" link2="arm_link_el0" reason="Never"/>
  <disable_collisions link1="arm_link_sh1" link2="arm_link_hr0" reason="Adjacent"/>
  <disable_collisions link1="arm_link_el0" link2="arm_link_el1" reason="Adjacent"/>
  <disable_collisions link1="arm_link_el0" link2="arm_link_wr0" reason="Never"/>
  <disable_collisions link1="arm_link_el0" link2="arm_link_wr1" reason="Never"/>
  <disable_collisions link1="arm_link_el0" link2="arm_link_hr0" reason="Adjacent"/>
  <disable_collisions link1="arm_link_el0" link2="arm_link_fngr" reason="Never"/>
  <disable_collisions link1="arm_link_el0" link2="arm_link_fixed" reason="Never"/>
  <disable_collisions link1="arm_link_el1" link2="arm_link_wr0" reason="Adjacent"/>
  <disable_collisions link1="arm_link_el1" link2="arm_link_wr1" reason="Default"/>
  <disable_collisions link1="arm_link_el1" link2="arm_link_fngr" reason="Never"/>
  <disable_collisions link1="arm_link_el1" link2="arm_link_fixed" reason="Never"/>
  <disable_collisions link1="arm_link_wr0" link2="arm_link_wr1" reason="Adjacent"/>
  <disable_collisions link1="arm_link_wr0" link2="arm_link_fngr" reason="Never"/>
  <disable_collisions link1="arm_link_wr0" link2="arm_link_fixed" reason="Never"/>
  <disable_collisions link1="arm_link_wr1" link2="arm_link_fngr" reason="Adjacent"/>
  <disable_collisions link1="arm_link_wr1" link2="arm_link_fixed" reason="Adjacent"/>
  <disable_collisions link1="arm_link_fngr" link2="arm_link_fixed" reason="Never"/>
</robot>
